FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the cTrader bridge script
COPY ctrader_bridge.py .

# Expose WebSocket port
EXPOSE 8082

# Set environment variables (will be overridden by docker-compose)
ENV CTRADER_CLIENT_ID=""
ENV CTRADER_CLIENT_SECRET=""
ENV CTRADER_ACCESS_TOKEN=""
ENV CTRADER_ACCOUNT_ID=""
ENV CTRADER_HOST_TYPE="live"
ENV CTRADER_BRIDGE_HOST="0.0.0.0"
ENV CTRADER_BRIDGE_PORT="8082"

# Run the bridge with auto-restart on failure
CMD ["python", "-u", "ctrader_bridge.py"]
